# autonomous-company-v2 — credential template (commit-safe)
# Copy to .env (gitignored) and fill in real values.

# Agent email account (sense: inbox_read + action: email_send)
RUNNER_EMAIL_ADDRESS=runner@runcor.ai
RUNNER_EMAIL_PASSWORD=
RUNNER_IMAP_HOST=mail.runcor.ai
RUNNER_IMAP_PORT=993
RUNNER_SMTP_HOST=mail.runcor.ai
RUNNER_SMTP_PORT=465

# OpenRouter (cognitive model calls)
OPENROUTER_API_KEY=

# External rater (good/evil score)
RATER_PROVIDER=anthropic
RATER_API_KEY=
RATER_MODEL=claude-opus-4-7

# Web search (sense: web_search)
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_API_KEY=

# Git push target (action: git_commit_push)
# Single dedicated workspace repo; agent commits anything here.
GIT_PUSH_REPO=runcor-ai/v2-workspace
GIT_PUSH_TOKEN=

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_PUBLIC_URL=https://runner-v2.runcor.ai

# Operator auth (pause/resume/note)
OPERATOR_AUTH_TOKEN=
