# autonomous-company-v2 — credential template (commit-safe)
# Copy to .env (gitignored) and fill in real values.

# Agent email account (sense: inbox_read + action: email_send)
RUNNER_EMAIL_ADDRESS=runner@runcor.ai
RUNNER_EMAIL_PASSWORD=
RUNNER_IMAP_HOST=mail.runcor.ai
RUNNER_IMAP_PORT=993
RUNNER_SMTP_HOST=mail.runcor.ai
RUNNER_SMTP_PORT=465

# OpenRouter — V2 dialectic + control naive Player + rater (one key)
OPENROUTER_API_KEY=

# Rater model (any OpenRouter slug). Default: anthropic/claude-3.5-sonnet
RATER_MODEL=anthropic/claude-3.5-sonnet

# Web search via Firecrawl /v1/search
FIRECRAWL_API_KEY=

# Git push target (action: git_commit_push)
GIT_PUSH_REPO=runcor-ai/v2-workspace
GIT_PUSH_TOKEN=

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_PUBLIC_URL=https://runner-v2.runcor.ai

# Operator auth (pause/resume/note + /scores)
OPERATOR_AUTH_TOKEN=

# Experiment knobs
V2_BUDGET_USD=100
CONTROL_BUDGET_USD=100
MAX_CYCLES=1000
V2_INTERVAL_SECONDS=30
CONTROL_INTERVAL_SECONDS=300
RATER_INTERVAL_MS=60000
